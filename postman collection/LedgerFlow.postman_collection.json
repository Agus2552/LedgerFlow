{
  "info": {
    "name": "LedgerFlow - Manual Tests",
    "description": "Run the API in Development after applying migrations. Execute requests in order: Create stores walletId for Get. Wallet endpoints create metadata only and are currently unauthenticated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5121",
      "type": "string"
    },
    {
      "key": "ownerId",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    },
    {
      "key": "walletId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health - API liveness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/plain"
          }
        ],
        "url": "{{baseUrl}}/health/live",
        "description": "Expected: HTTP 200 and Healthy. Does not verify database readiness."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('API is healthy', () => pm.expect(pm.response.text()).to.eql('Healthy'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Health - Database readiness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/plain"
          }
        ],
        "url": "{{baseUrl}}/health/ready",
        "description": "Expected HTTP 200 and Healthy when PostgreSQL is available. Otherwise HTTP 503 and Unhealthy."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('API is healthy', () => pm.expect(pm.response.text()).to.eql('Healthy'));"
            ]
          }
        }
      ]
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));",
              "pm.test('Active USD wallet and Location', () => { const w = pm.response.json(); pm.expect(w.currency).to.eql('USD'); pm.expect(w.status).to.eql('Active'); pm.expect(w.ownerId).to.eql(pm.collectionVariables.get('ownerId')); pm.expect(pm.response.headers.get('Location')).to.eql('/wallets/' + w.id); pm.collectionVariables.set('walletId', w.id); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "raw": "{\n  \"ownerId\": \"{{ownerId}}\",\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "mode": "raw"
        },
        "url": "{{baseUrl}}/wallets",
        "description": "Creates metadata only. Every successful POST creates a new wallet; idempotency is not implemented.",
        "method": "POST"
      },
      "name": "Wallets - Create USD wallet"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Found', () => pm.response.to.have.status(200));",
              "pm.test('Same persisted wallet', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('walletId')));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "url": "{{baseUrl}}/wallets/{{walletId}}",
        "method": "GET"
      },
      "name": "Wallets - Get created wallet"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Validation error', () => pm.response.to.have.status(400));",
              "pm.test('Currency error', () => pm.expect(pm.response.json().errors).to.have.property('currency'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "raw": "{\"ownerId\":\"{{ownerId}}\",\"currency\":\"EUR\"}",
          "mode": "raw"
        },
        "url": "{{baseUrl}}/wallets",
        "method": "POST"
      },
      "name": "Wallets - Reject unsupported currency"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Validation error', () => pm.response.to.have.status(400));",
              "pm.test('Owner error', () => pm.expect(pm.response.json().errors).to.have.property('ownerId'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "raw": "{\"ownerId\":\"00000000-0000-0000-0000-000000000000\",\"currency\":\"USD\"}",
          "mode": "raw"
        },
        "url": "{{baseUrl}}/wallets",
        "method": "POST"
      },
      "name": "Wallets - Reject empty owner"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Not found', () => pm.response.to.have.status(404));",
              "pm.test('Problem details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "url": "{{baseUrl}}/wallets/{{$guid}}",
        "method": "GET"
      },
      "name": "Wallets - Unknown wallet"
    }
  ]
}
